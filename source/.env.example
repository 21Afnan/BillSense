# Copy to .env and fill in your keys. Never commit or submit the real .env.
# Level 1 (extraction) runs fully offline with local OCR and needs no key. Level 2 needs at least one key.

# ---- Level 2 language models (only competition-approved models are accepted by the code)
# Primary: Gemini (Google AI Studio)
MODEL_PROVIDER=google
MODEL_NAME=gemini-3.5-flash-lite
API_KEY=your-gemini-key-here
# Gemini key 2: fallback when key 1 is rejected or Google is failing (alias accepted: GEMINI_API_KEY2)
GEMINI_API_KEY_2=your-gemini-key-here
# Fallback provider when Gemini is unavailable or rate-limited (alias accepted: CLAUDE_API_KEY)
FALLBACK_MODEL_PROVIDER=anthropic
FALLBACK_MODEL_NAME=claude-haiku-4-5
ANTHROPIC_API_KEY=your-anthropic-key-here

# ---- Tuning
REQUESTS_PER_MINUTE=12
MAX_RETRIES=2
REQUEST_TIMEOUT_SECONDS=90
# Where OCR and LLM responses are cached (default: .cache in the project root)
# CACHE_DIR=

# ---- Optional web API (app/main.py): browser origins allowed to call it
CORS_ORIGINS=http://localhost:3000
